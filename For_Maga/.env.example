# Скопируйте этот файл в .env и заполните значения.
# .env не должен попадать в git (см. .gitignore).

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
ANTHROPIC_PROXY=

LOOPBACK_DEVICE=
INPUT_GAIN=1.0

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

SCREENSHOT_MONITOR=1
SCREENSHOT_MODE=full

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_AUDIO=true
TELEGRAM_SEND_SCREEN=true
TELEGRAM_SEND_SCREENSHOT=false
